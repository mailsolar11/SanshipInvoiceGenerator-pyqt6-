<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ReportsWindow</class>
 <widget class="QWidget" name="ReportsWindow">
  <layout class="QVBoxLayout">

   <item>
    <widget class="QTabWidget" name="tabWidget">

     <!-- TRIAL BALANCE -->
     <widget class="QWidget" name="tabTrial">
      <layout class="QVBoxLayout">
       <item>
        <widget class="QTableWidget" name="tableTrial">
         <property name="columnCount"><number>3</number></property>
         <column><property name="text"><string>Ledger</string></property></column>
         <column><property name="text"><string>Debit</string></property></column>
         <column><property name="text"><string>Credit</string></property></column>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- PROFIT & LOSS -->
     <widget class="QWidget" name="tabPNL">
